DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=your-domain.example.com
CSRF_TRUSTED_ORIGINS=https://your-domain.example.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_SSL_REQUIRE=True
TIME_ZONE=Asia/Tashkent
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@example.com
SECURE_SSL_REDIRECT=True
ALLOW_DOCTOR_SELF_REGISTRATION=False
# Fresh PostgreSQL deploymentda eski ZIP ichidagi ma'lumotlarni bir marta ko'chirish uchun True qiling.
LOAD_INITIAL_DATA=False
# Railway volume ishlatilsa: MEDIA_ROOT=/data/media
MEDIA_ROOT=/app/media
# PostgreSQL ishlatilmasa va Railway volume bo'lsa: SQLITE_PATH=/data/db.sqlite3
SQLITE_PATH=/app/db.sqlite3
# Vercel production: set these in Project Settings for persistent production use.
# SECRET_KEY=generate-a-long-random-value
# DATABASE_URL=postgresql://...
# ALLOWED_HOSTS=.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app
